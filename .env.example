PORT=3000

# ID da planilha Google (esta no meio da URL da planilha)
SPREADSHEET_ID=

# Dados da conta de servico (veja SETUP.md)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Cole a private_key exatamente como veio no JSON, mantendo os \n
GOOGLE_PRIVATE_KEY=

# Qualquer texto longo e aleatorio, usado para assinar o login
JWT_SECRET=troque-por-um-texto-aleatorio-bem-grande
