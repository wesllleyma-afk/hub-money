<!DOCTYPE html>
<html lang="pt-br">
<head><%- include('../partials/head') %></head>
<body class="has-sidebar">
<%- include('../partials/nav') %>
<div class="container">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Usuários</h3>
    <a href="/usuarios/novo" class="btn btn-primary">+ Novo usuário</a>
  </div>
  <div class="card p-0">
    <table class="table mb-0">
      <thead><tr><th>Nome</th><th>Usuário</th><th>Papel</th><th>E-mail do relatório</th></tr></thead>
      <tbody>
        <% usuarios.forEach(u => { %>
          <tr>
            <td><%= u.nome %></td>
            <td><a href="/usuarios/<%= u.id %>"><%= u.usuario %></a></td>
            <td><%= u.papel %></td>
            <td><%= u.email_relatorio || '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
</body>
</html>
