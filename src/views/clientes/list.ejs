<!DOCTYPE html>
<html lang="pt-br">
<head><%- include('../partials/head') %></head>
<body class="has-sidebar">
<%- include('../partials/nav') %>
<div class="container">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Clientes</h3>
    <a href="/clientes/novo" class="btn btn-primary">+ Novo cliente</a>
  </div>
  <form method="GET" class="mb-3">
    <input type="text" name="q" value="<%= busca %>" class="form-control" placeholder="Buscar por nome ou CPF...">
  </form>
  <div class="card p-0">
    <table class="table mb-0">
      <thead><tr><th>Nome</th><th>CPF</th><th>Telefone</th><th></th></tr></thead>
      <tbody>
        <% clientes.forEach(c => { %>
          <tr>
            <td><%= c.nome %></td>
            <td><%= c.cpf %></td>
            <td><%= c.telefone %></td>
            <td><a href="/clientes/<%= c.id %>" class="btn btn-sm btn-outline-primary">Ver</a></td>
          </tr>
        <% }) %>
        <% if (clientes.length === 0) { %>
          <tr><td colspan="4" class="text-center text-muted py-3">Nenhum cliente encontrado.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
</body>
</html>
