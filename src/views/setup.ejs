<!DOCTYPE html>
<html lang="pt-br">
<head><%- include('partials/head') %></head>
<body>
  <div class="container d-flex align-items-center justify-content-center" style="min-height:100vh;">
    <div class="card p-4" style="max-width:420px; width:100%;">
      <div class="text-center mb-3">
        <img src="/img/logo.png" alt="Hub Money" style="width:120px; height:120px; object-fit:contain;">
      </div>
      <h3 class="mb-1 text-center">Configuração inicial</h3>
      <p class="text-muted text-center small">Crie a primeira conta (administrador) do sistema.</p>
      <% if (erro) { %><div class="alert alert-danger"><%= erro %></div><% } %>
      <form method="POST" action="/setup">
        <div class="mb-3">
          <label class="form-label">Seu nome</label>
          <input type="text" name="nome" class="form-control" required autofocus>
        </div>
        <div class="mb-3">
          <label class="form-label">E-mail</label>
          <input type="email" name="email" class="form-control" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Senha</label>
          <input type="password" name="senha" class="form-control" required minlength="6">
        </div>
        <button type="submit" class="btn btn-primary w-100">Criar conta e entrar</button>
      </form>
    </div>
  </div>
</body>
</html>
