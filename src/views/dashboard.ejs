<!DOCTYPE html>
<html lang="pt-br">
<head><%- include('partials/head') %></head>
<body class="has-sidebar">
<%- include('partials/nav') %>
<div class="container">
  <h3 class="mb-4">Painel</h3>
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card p-3">
        <div class="text-muted small">Clientes cadastrados</div>
        <div class="fs-3 fw-bold"><%= totalClientes %></div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card p-3">
        <div class="text-muted small">Capital emprestado (ativo)</div>
        <div class="fs-3 fw-bold">R$ <%= totalEmprestado.toFixed(2) %></div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card p-3">
        <div class="text-muted small">Em atraso (<%= qtdAtrasados %>)</div>
        <div class="fs-3 fw-bold text-danger">R$ <%= totalDevidoAtraso.toFixed(2) %></div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card p-3">
        <div class="text-muted small">Recebido este mês</div>
        <div class="fs-3 fw-bold text-success">R$ <%= recebidoNoMes.toFixed(2) %></div>
      </div>
    </div>
  </div>

  <div class="card p-4 mb-4">
    <h5 class="mb-3">Cobranças de hoje</h5>
    <div class="row g-4">
      <div class="col-md-4">
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="badge badge-status-atrasado">atrasado</span>
          <span class="text-muted small">Cobrar com urgência</span>
        </div>
        <% if (cobrancasAtrasadas.length === 0) { %>
          <div class="text-muted small">Nenhum cliente atrasado.</div>
        <% } else { %>
          <ul class="list-unstyled mb-0">
            <% cobrancasAtrasadas.forEach(e => { %>
              <li class="mb-2">
                <a href="/emprestimos/<%= e.id %>"><%= e.cliente ? e.cliente.nome : '—' %></a>
                <div class="text-muted small">
                  <%= e.diasAtraso %> dia(s) de atraso · R$ <%= e.valorRenovacao.toFixed(2) %> p/ regularizar
                </div>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
      <div class="col-md-4">
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="badge" style="background-color:#fd7e14;">vence hoje</span>
          <span class="text-muted small">Cobrar hoje</span>
        </div>
        <% if (cobrancasHoje.length === 0) { %>
          <div class="text-muted small">Nenhum vencimento hoje.</div>
        <% } else { %>
          <ul class="list-unstyled mb-0">
            <% cobrancasHoje.forEach(e => { %>
              <li class="mb-2">
                <a href="/emprestimos/<%= e.id %>"><%= e.cliente ? e.cliente.nome : '—' %></a>
                <div class="text-muted small">R$ <%= e.valorRenovacao.toFixed(2) %></div>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
      <div class="col-md-4">
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="badge bg-secondary">vence amanhã</span>
          <span class="text-muted small">Se organizar</span>
        </div>
        <% if (cobrancasAmanha.length === 0) { %>
          <div class="text-muted small">Nenhum vencimento amanhã.</div>
        <% } else { %>
          <ul class="list-unstyled mb-0">
            <% cobrancasAmanha.forEach(e => { %>
              <li class="mb-2">
                <a href="/emprestimos/<%= e.id %>"><%= e.cliente ? e.cliente.nome : '—' %></a>
                <div class="text-muted small">R$ <%= e.valorRenovacao.toFixed(2) %></div>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </div>
  </div>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Empréstimos recentes</h5>
    <a href="/emprestimos/novo" class="btn btn-primary btn-sm">+ Novo empréstimo</a>
  </div>
  <div class="card p-0">
    <table class="table mb-0">
      <thead><tr><th>Vencimento</th><th>Capital</th><th>Juro/ciclo</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% emprestimosRecentes.forEach(e => { %>
          <tr>
            <td><%= e.data_vencimento_atual %></td>
            <td>R$ <%= e.valor_principal.toFixed(2) %></td>
            <td>R$ <%= e.valor_juros_ciclo.toFixed(2) %></td>
            <td><span class="badge badge-status-<%= e.statusExibicao %>"><%= e.statusExibicao %></span></td>
            <td><a href="/emprestimos/<%= e.id %>" class="btn btn-sm btn-outline-primary">Ver</a></td>
          </tr>
        <% }) %>
        <% if (emprestimosRecentes.length === 0) { %>
          <tr><td colspan="5" class="text-center text-muted py-3">Nenhum empréstimo cadastrado ainda.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
</body>
</html>
