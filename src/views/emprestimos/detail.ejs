<!DOCTYPE html>
<html lang="pt-br">
<head><%- include('../partials/head') %></head>
<body class="has-sidebar">
<%- include('../partials/nav') %>
<div class="container">
  <div class="d-flex justify-content-between align-items-start mb-3">
    <div>
      <h3 class="mb-0">
        Empréstimo de <a href="/clientes/<%= cliente.id %>"><%= cliente.nome %></a>
      </h3>
      <span class="badge badge-status-<%= emprestimo.statusExibicao %>"><%= emprestimo.statusExibicao %></span>
      <% if (emprestimo.emprestimo_origem_id) { %>
        <span class="text-muted small">· renegociação de outro empréstimo</span>
      <% } %>
    </div>
  </div>

  <div class="card p-4 mb-4">
    <div class="row g-3">
      <div class="col-6 col-md-3">
        <div class="text-muted small">Capital</div>
        <div class="fs-5 fw-bold">R$ <%= emprestimo.valor_principal.toFixed(2) %></div>
      </div>
      <div class="col-6 col-md-3">
        <div class="text-muted small">Juros por ciclo</div>
        <div class="fs-5 fw-bold">R$ <%= emprestimo.valor_juros_ciclo.toFixed(2) %></div>
        <div class="text-muted small"><%= emprestimo.percentualJuros.toFixed(1) %>% sobre o capital</div>
      </div>
      <div class="col-6 col-md-3">
        <div class="text-muted small">Prazo</div>
        <div class="fs-5 fw-bold"><%= emprestimo.prazo_dias %> dias</div>
      </div>
      <div class="col-6 col-md-3">
        <div class="text-muted small">Data de pagamento</div>
        <div class="fs-5 fw-bold"><%= emprestimo.data_vencimento_atual %></div>
      </div>
      <div class="col-6 col-md-3">
        <div class="text-muted small">Situação</div>
        <div class="mt-1"><span class="badge badge-status-<%= emprestimo.statusExibicao %>"><%= emprestimo.statusExibicao %></span></div>
      </div>
      <div class="col-6 col-md-3">
        <div class="text-muted small">Multa por atraso</div>
        <div class="fs-5 fw-bold">R$ <%= emprestimo.multa_por_dia.toFixed(2) %>/dia</div>
      </div>
    </div>
  </div>

  <% if (emprestimo.diasAtraso > 0) { %>
    <div class="alert alert-danger">
      Atrasado há <strong><%= emprestimo.diasAtraso %> dia(s)</strong> ·
      Multa acumulada: <strong>R$ <%= emprestimo.multaAcumulada.toFixed(2) %></strong>
      (R$ <%= emprestimo.multa_por_dia.toFixed(2) %>/dia)
    </div>
  <% } %>

  <% if (emprestimo.pagoNoCiclo > 0) { %>
    <div class="alert alert-warning">
      Pagamento parcial recebido neste ciclo: <strong>R$ <%= emprestimo.pagoNoCiclo.toFixed(2) %></strong> ·
      Falta cobrar <strong>R$ <%= emprestimo.saldoRenovacao.toFixed(2) %></strong> para completar o juro do ciclo.
    </div>
  <% } %>

  <% if (emprestimo.status === 'ativo') { %>
  <div class="row g-3 mb-4">
    <div class="col-md-6">
      <div class="card p-3 h-100 d-flex justify-content-center">
        <form method="POST" action="/emprestimos/<%= emprestimo.id %>/renovar">
          <input type="hidden" name="valor_pago" value="<%= emprestimo.saldoRenovacao.toFixed(2) %>">
          <button type="submit" class="btn btn-success w-100">Confirmar renovação</button>
        </form>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card p-3 h-100 d-flex justify-content-center">
        <form method="POST" action="/emprestimos/<%= emprestimo.id %>/quitar">
          <input type="hidden" name="valor_pago" value="<%= emprestimo.saldoQuitacao.toFixed(2) %>">
          <button type="submit" class="btn btn-primary w-100">Confirmar quitação</button>
        </form>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card p-3 h-100">
        <form method="POST" action="/emprestimos/<%= emprestimo.id %>/pagamento-parcial">
          <div class="input-group mb-2">
            <span class="input-group-text">R$</span>
            <input type="number" step="0.01" name="valor" class="form-control" placeholder="Valor pago" required>
          </div>
          <input type="text" name="observacao" class="form-control mb-2" placeholder="Observação (opcional)">
          <button type="submit" class="btn btn-outline-secondary w-100">Registrar pagamento parcial</button>
        </form>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card p-3 h-100">
        <button type="button" class="btn btn-warning w-100" id="btn-abrir-renegociar">Renegociar dívida</button>
        <form method="POST" action="/emprestimos/<%= emprestimo.id %>/renegociar" class="d-none mt-3" id="form-renegociar">
          <div class="input-group mb-2">
            <span class="input-group-text">Capital R$</span>
            <input type="number" step="0.01" name="valor_principal" class="form-control" value="<%= emprestimo.valorQuitacao.toFixed(2) %>" required>
          </div>
          <div class="input-group mb-2">
            <span class="input-group-text">Juro/ciclo R$</span>
            <input type="number" step="0.01" name="valor_juros_ciclo" class="form-control" value="<%= emprestimo.valor_juros_ciclo.toFixed(2) %>" required>
          </div>
          <div class="input-group mb-2">
            <span class="input-group-text">Prazo (dias)</span>
            <input type="number" name="prazo_dias" class="form-control" value="<%= emprestimo.prazo_dias %>" required>
          </div>
          <div class="input-group mb-2">
            <span class="input-group-text">Multa/dia R$</span>
            <input type="number" step="0.01" name="multa_por_dia" class="form-control" value="<%= emprestimo.multa_por_dia.toFixed(2) %>" required>
          </div>
          <button type="submit" class="btn btn-warning w-100">Confirmar renegociação</button>
        </form>
      </div>
    </div>
  </div>
  <script>
    document.getElementById('btn-abrir-renegociar').addEventListener('click', function () {
      this.classList.add('d-none');
      document.getElementById('form-renegociar').classList.remove('d-none');
    });
  </script>
  <% } %>

  <h5 class="mb-3">Histórico de pagamentos</h5>
  <div class="card p-0">
    <table class="table mb-0">
      <thead><tr><th>Data</th><th>Tipo</th><th>Valor</th><th>Observação</th></tr></thead>
      <tbody>
        <% emprestimo.pagamentos.forEach(p => { %>
          <tr>
            <td><%= p.data %></td>
            <td><%= p.tipo %></td>
            <td>R$ <%= Number(p.valor).toFixed(2) %></td>
            <td><%= p.observacao %></td>
          </tr>
        <% }) %>
        <% if (emprestimo.pagamentos.length === 0) { %>
          <tr><td colspan="4" class="text-center text-muted py-3">Nenhum pagamento registrado ainda.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
</body>
</html>
